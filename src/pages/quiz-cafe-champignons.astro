---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogHero from '@/components/BlogHero.astro';
import SidebarCTA from '@/components/SidebarCTA.astro';
import FAQSection from '@/components/FAQSection.astro';
import ArticleGrid from '@/components/ArticleGrid.astro';
import config from '@/data/site.config';
const topProduct = config.products[0];
const title = "Quel cafe aux champignons est fait pour vous ? (Quiz gratuit)";
const description = "Repondez a 5 questions et trouvez le cafe aux champignons adapte a vos objectifs : focus, energie, digestion ou detox. Recommandation personnalisee.";
const faq = [
  { question: 'Le cafe aux champignons contient-il de la cafeine ?', answer: 'La plupart contiennent entre 50 et 100 mg de cafeine par tasse (environ moitie moins qu\'un expresso). Certains sont decafeines. Le quiz prend en compte votre tolerance.' },
  { question: 'Quels champignons sont les plus efficaces pour la concentration ?', answer: 'Le Lion\'s Mane (criniere de lion) est le plus etudie pour le soutien cognitif. Les produits qui le combinent avec un peu de cafeine offrent le meilleur equilibre focus/energie.' },
  { question: 'Le cafe aux champignons a-t-il des effets secondaires ?', answer: 'Les effets secondaires sont rares aux doses recommandees. Certaines personnes sensibles peuvent ressentir des troubles digestifs au debut. Commencez par une demi-dose.' },
  { question: 'Poudre ou capsules pour le cafe aux champignons ?', answer: 'La poudre se melange comme un cafe classique et offre une experience plus proche. Les capsules sont plus pratiques pour les deplacements mais perdent le rituel cafe.' },
];
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'WebApplication', name: title, description, applicationCategory:'HealthApplication', operatingSystem:'Web', offers:{'@type':'Offer',price:'0',priceCurrency:'EUR'}, author:{'@type':'Person', name:'Tim'} })} />
  <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'FAQPage', mainEntity: faq.map(f=>({'@type':'Question', name:f.question, acceptedAnswer:{'@type':'Answer', text:f.answer}})) })} />
  <BlogHero title={title} description={description} author="Tim" authorAvatar="/author-avatar.png" date="7 aout 2026" readingTime="2 min" breadcrumbs={[{label:'Comparatif',href:'/'},{label:'Quiz',href:'/quiz-cafe-champignons/'}]} bannerImage="/images/content/emd-cafe-champignons-banner.webp" product={{ name: topProduct.name, image: topProduct.image, promoCode: topProduct.promoCode, promoPercent: topProduct.promoPercent, originalPrice: topProduct.originalPrice, discountPrice: topProduct.discountPrice, affiliateLink: topProduct.affiliateLink }} heroButton={{text:'Faire le quiz', href:'#quiz'}} showOfferBlock={false} />
  <main style="background:#fff"><div class="container-large padding-global"><div class="padding-section-medium"><div class="blog-grid"><article class="content-column rich-text">
    <section id="quiz">
      <h2>Trouvez votre cafe aux champignons ideal</h2>
      <p>5 questions pour une recommandation personnalisee parmi les meilleurs cafes aux champignons testes.</p>
      <div id="quiz-container" class="quiz-container"><div class="quiz-progress"><div class="quiz-progress-bar" id="quiz-progress-bar"></div></div><div id="quiz-step" class="quiz-step"></div></div>
      <div id="quiz-result" class="calc-result" style="display:none"><div class="result-header"><span class="result-match">Votre meilleur choix</span></div><div id="result-product"></div><div id="result-why"></div><div id="product-cards"></div></div>
    </section>
    <h2>Pourquoi faire ce quiz ?</h2>
    <p>Tous les cafes aux champignons ne se valent pas. Certains misent sur le Lion\'s Mane pour la concentration, d\'autres sur le Chaga pour l\'immunite ou le Reishi pour la relaxation. Votre choix depend de votre objectif principal, votre sensibilite a la cafeine et votre budget.</p>
    <FAQSection faq={faq} title="Questions frequentes" />
    <ArticleGrid currentPath="/quiz-cafe-champignons/" />
  </article><aside class="sidebar-column"><div class="sidebar-sticky"><SidebarCTA logoSrc={topProduct.brandLogo} productName={topProduct.name} brandName={topProduct.brand} promoCode={topProduct.promoCode} promoPercent={topProduct.promoPercent} originalPrice={topProduct.originalPrice} discountPrice={topProduct.discountPrice} ctaLink={topProduct.affiliateLink} heroImage={topProduct.image} rating={topProduct.rating} reviewCount={topProduct.reviewCount} /></div></aside></div></div></div></main>
</BaseLayout>
<script is:inline>
(function(){
  var questions=[
    {q:'Quel est votre objectif principal ?',opts:[{label:'Concentration et productivite',val:'focus'},{label:'Energie sans nervosites',val:'energy'},{label:'Digestion et bien-etre',val:'gut'},{label:'Relaxation et sommeil',val:'relax'}]},
    {q:'Votre consommation de cafeine actuelle ?',opts:[{label:'Aucune ou tres peu',val:'none'},{label:'1-2 tasses par jour',val:'moderate'},{label:'3+ tasses par jour',val:'high'}]},
    {q:'Format prefere ?',opts:[{label:'Poudre (comme un cafe)',val:'powder'},{label:'Capsules',val:'capsules'},{label:'Pas de preference',val:'any'}]},
    {q:'Budget mensuel ?',opts:[{label:'Moins de 25 euros',val:'low'},{label:'25-40 euros',val:'mid'},{label:'40+ euros, qualite avant tout',val:'high'}]},
    {q:'Preference alimentaire ?',opts:[{label:'Aucune restriction',val:'none2'},{label:'Vegan / vegetal',val:'vegan'},{label:'Bio de preference',val:'organic'}]}
  ];
  var products=[
    {id:'mushngo',name:'Brainstoorm',brand:'Mush N Go',image:'https://cdn.prod.website-files.com/68c02c2c477fdd467e6e08a1/69634d74b3e93e5fd12d108d_1_8789ecf0-bcc9-4b45-b2f9-c8bfca54ab16_1000x1000_crop_center.webp',rating:9.7,promoCode:'LMC15',promoPercent:15,originalPrice:'29,90 euros',discountPrice:'25,42 euros',affiliateLink:'https://taap.it/mushngo-brainstorm',tags:['focus','energy','powder','mid','high','vegan','organic'],desc:'Meilleur choix global. Lion\'s Mane + Cordyceps + vrai gout cafe. Le plus complet pour la concentration et l\'energie.'},
    {id:'bonjour',name:'Mushroom Coffee',brand:'Bonjour Drink',image:'/images/products/bonjour-drink.webp',rating:9.2,promoCode:'LMC15',promoPercent:15,originalPrice:'29,90 euros',discountPrice:'25,42 euros',affiliateLink:'https://www.bonjourdrink.com/products/mushroom-coffee?sca_ref=7861282.BsYH2LhStj',tags:['focus','gut','powder','mid','none','organic'],desc:'Excellente alternative francaise avec 6 champignons. Ideal pour la digestion et le bien-etre general.'},
    {id:'primal',name:'Primal Coffee',brand:'Primal Harvest',image:'/images/products/primal-harvest.webp',rating:8.6,promoCode:'',promoPercent:0,originalPrice:'34,90 euros',discountPrice:'34,90 euros',affiliateLink:'https://primal-harvest.com',tags:['energy','relax','powder','capsules','mid','high','none2'],desc:'Bon rapport qualite-prix avec une formule equilibree. Convient bien pour l\'energie au quotidien.'}
  ];
  var step=0,answers=[];var container=document.getElementById('quiz-step'),progress=document.getElementById('quiz-progress-bar');
  function render(){if(step>=questions.length){showResult();return;}var q=questions[step];progress.style.width=((step/questions.length)*100)+'%';var html='<div class="quiz-question"><div class="quiz-q-num">Question '+(step+1)+'/'+questions.length+'</div><h3 class="quiz-q-text">'+q.q+'</h3><div class="quiz-options">';q.opts.forEach(function(o){html+='<button class="quiz-option" data-val="'+o.val+'">'+o.label+'</button>';});html+='</div></div>';container.innerHTML=html;container.querySelectorAll('.quiz-option').forEach(function(btn){btn.addEventListener('click',function(){answers.push(btn.getAttribute('data-val'));step++;render();});});}
  function showResult(){progress.style.width='100%';document.getElementById('quiz-container').style.display='none';var scores={};products.forEach(function(p){scores[p.id]=0;});answers.forEach(function(a){products.forEach(function(p){if(p.tags.indexOf(a)>=0)scores[p.id]+=2;});});var sorted=products.slice().sort(function(a,b){return scores[b.id]-scores[a.id];});var best=sorted[0];
    document.getElementById('result-product').innerHTML='<div class="match-card"><img src="'+best.image+'" alt="'+best.name+'" class="match-img" /><div class="match-body"><div class="match-brand">'+best.brand+'</div><div class="match-name">'+best.name+'</div><div class="match-rating">'+best.rating+'/10</div><div class="match-price">'+(best.promoPercent>0?'<span class="price-old">'+best.originalPrice+'</span> ':'')+'<span class="price-new">'+best.discountPrice+'</span></div><a href="'+best.affiliateLink+'" target="_blank" rel="nofollow sponsored" class="p-card-cta">Voir l\'offre</a>'+(best.promoCode?'<div class="p-card-promo">Code : <strong>'+best.promoCode+'</strong> (-'+best.promoPercent+'%)</div>':'')+'</div></div>';
    document.getElementById('result-why').innerHTML='<p class="match-desc"><strong>Pourquoi ce choix :</strong> '+best.desc+'</p>';
    var html='<h3 class="cards-title">Autres options</h3><div class="cards-grid">';sorted.slice(1).forEach(function(p,i){html+='<div class="p-card"><div class="p-card-rank">#'+(i+2)+'</div><img src="'+p.image+'" alt="'+p.name+'" class="p-card-img" /><div class="p-card-body"><div class="p-card-brand">'+p.brand+'</div><div class="p-card-name">'+p.name+'</div><a href="'+p.affiliateLink+'" target="_blank" rel="nofollow sponsored" class="p-card-cta">Voir</a></div></div>';});html+='</div>';
    document.getElementById('product-cards').innerHTML=html;document.getElementById('quiz-result').style.display='block';document.getElementById('quiz-result').scrollIntoView({behavior:'smooth',block:'start'});
    if(typeof gtag==='function')gtag('event','quiz_complete',{event_category:'engagement',event_label:'cafe_champignons',value:best.id});}
  render();
})();
</script>
<style is:global>
.quiz-container{background:#faf9f6;border:1px solid #e8e5de;border-radius:1rem;padding:clamp(1.25rem,2.5vw,2rem);margin:1.5rem 0}.quiz-progress{height:4px;background:#e8e5de;border-radius:2px;margin-bottom:1.5rem;overflow:hidden}.quiz-progress-bar{height:100%;background:#ef7a1a;border-radius:2px;transition:width .4s;width:0}.quiz-question{text-align:center}.quiz-q-num{font-family:'Archivo',sans-serif;font-weight:600;font-size:.8125rem;color:#999;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem}.quiz-q-text{font-family:'Archivo',sans-serif;font-weight:700;font-size:clamp(1.25rem,2vw,1.75rem);color:#242424;margin:0 0 1.5rem}.quiz-options{display:flex;flex-direction:column;gap:.75rem;max-width:400px;margin:0 auto}.quiz-option{font-family:'PT Sans',sans-serif;font-size:1rem;padding:.875rem 1.25rem;border:2px solid #d5d0c7;border-radius:.625rem;background:#fff;color:#242424;cursor:pointer;transition:all .2s;text-align:left}.quiz-option:hover{border-color:#ef7a1a;background:#fef6f0;transform:translateX(4px)}
.calc-result{background:#faf9f6;border:1px solid #e8e5de;border-radius:1rem;padding:clamp(1.5rem,3vw,2.5rem);margin:2rem 0}.result-header{text-align:center;margin-bottom:1.5rem}.result-match{font-family:'Archivo',sans-serif;font-weight:800;font-size:clamp(1.5rem,3vw,2rem);color:#ef7a1a}
.match-card{display:flex;gap:1.5rem;align-items:center;background:#fff;border:1px solid #e8e5de;border-radius:.75rem;padding:1.5rem;margin-bottom:1rem}.match-img{width:120px;height:120px;object-fit:contain;border-radius:.5rem;flex-shrink:0}.match-body{flex:1}.match-brand{font-size:.75rem;color:#999;text-transform:uppercase;letter-spacing:.04em}.match-name{font-family:'Archivo',sans-serif;font-weight:700;font-size:1.25rem;color:#242424;margin:.25rem 0}.match-rating{font-family:'Archivo',sans-serif;font-weight:700;color:#ef7a1a;font-size:1rem}.match-price{margin:.375rem 0}.match-desc{color:#555;line-height:1.6;margin:.5rem 0 1.5rem}@media(max-width:600px){.match-card{flex-direction:column;text-align:center}.match-img{margin:0 auto}}
.price-old{font-size:.8125rem;color:#999;text-decoration:line-through}.price-new{font-family:'Archivo',sans-serif;font-weight:700;font-size:1.125rem;color:#ef7a1a}.cards-title{font-family:'Archivo',sans-serif;font-weight:700;font-size:1.25rem;color:#242424;margin:0 0 1rem}.cards-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}@media(max-width:767px){.cards-grid{grid-template-columns:1fr}}
.p-card{background:#fff;border:1px solid #e8e5de;border-radius:.75rem;overflow:hidden;text-align:center;position:relative;transition:transform .2s,box-shadow .2s}.p-card:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.08)}.p-card-rank{position:absolute;top:.5rem;left:.5rem;background:#ef7a1a;color:#fff;font-family:'Archivo',sans-serif;font-weight:700;font-size:.75rem;width:1.75rem;height:1.75rem;border-radius:50%;display:flex;align-items:center;justify-content:center}.p-card-img{width:100%;height:140px;object-fit:contain;padding:1rem;background:#faf9f6}.p-card-body{padding:1rem;display:flex;flex-direction:column;gap:.375rem}.p-card-brand{font-size:.75rem;color:#999;text-transform:uppercase;letter-spacing:.04em}.p-card-name{font-family:'Archivo',sans-serif;font-weight:700;font-size:.9375rem;color:#242424}.p-card-cta{display:inline-flex;align-items:center;justify-content:center;background:#ef7a1a;color:#fff;font-family:'Archivo',sans-serif;font-weight:700;font-size:.875rem;padding:.625rem 1.25rem;border-radius:.5rem;text-decoration:none;transition:background .2s;margin-top:.375rem}.p-card-cta:hover{background:#d66a12}.p-card-promo{font-size:.75rem;color:#4caf50;font-weight:600;margin-top:.25rem}
</style>
